{
  "name": "@typeonce/effect-machine",
  "version": "0.28.0",
  "description": "Schema-first state machines and statecharts for Effect",
  "author": "Sandro Maglione",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typeonce-dev/effect-machine.git"
  },
  "bugs": {
    "url": "https://github.com/typeonce-dev/effect-machine/issues"
  },
  "homepage": "https://github.com/typeonce-dev/effect-machine#readme",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./reactivity": {
      "types": "./src/unstable/reactivity/index.ts",
      "import": "./src/unstable/reactivity/index.ts"
    },
    "./cluster": {
      "types": "./src/unstable/cluster/index.ts",
      "import": "./src/unstable/cluster/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./src/testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./reactivity": {
        "types": "./dist/unstable/reactivity/index.d.ts",
        "import": "./dist/unstable/reactivity/index.js"
      },
      "./cluster": {
        "types": "./dist/unstable/cluster/index.d.ts",
        "import": "./dist/unstable/cluster/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check": "tsc -b tsconfig.json",
    "test:types": "tstyche"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "25.7.0",
    "effect": "4.0.0-rc.112",
    "tinybench": "2.9.0",
    "tstyche": "7.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
