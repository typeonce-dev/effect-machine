{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node"]
  },
  "include": ["consumer.ts", "deep-bound.ts"]
}
